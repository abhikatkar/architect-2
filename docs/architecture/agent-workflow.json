{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Northwind Helpline: the right model type per decision",
    "visual_preset": "blueprint",
    "quality_profile": "showcase",
    "output": "public/architecture/agent-workflow.html",
    "views": [
      {
        "id": "happy-path",
        "label": "Message to reply",
        "focus": [
          "msg",
          "intake",
          "answer",
          "ground",
          "send"
        ],
        "note": "Three typed decisions and one piece of writing, in the order they happen."
      },
      {
        "id": "decisions",
        "label": "The three decisions",
        "focus": [
          "intake",
          "ground",
          "escal"
        ],
        "note": "Each has a fixed answer space, so a decision model cannot invent an answer outside it."
      },
      {
        "id": "escalation",
        "label": "Routes to a person",
        "focus": [
          "intake",
          "ground",
          "escal"
        ],
        "note": "Two agents can hand a message to a person: the checker when a draft is not supported, and Intake when it is not clearly decided."
      }
    ],
    "viewBox": [
      1200,
      534
    ]
  },
  "lanes": [
    {
      "id": "customer",
      "label": "Customer"
    },
    {
      "id": "decide",
      "label": "Decision model: Jev"
    },
    {
      "id": "write",
      "label": "Language model"
    }
  ],
  "phases": [
    {
      "id": "sort",
      "label": "Sort",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "handoff",
      "label": "Hand to a person",
      "fromCol": 2,
      "toCol": 2,
      "variant": "dashed"
    },
    {
      "id": "draft",
      "label": "Draft",
      "fromCol": 3,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "check",
      "label": "Check and route",
      "fromCol": 4,
      "toCol": 5
    }
  ],
  "mainPath": [
    "msg",
    "intake",
    "answer",
    "ground",
    "send"
  ],
  "nodes": [
    {
      "id": "msg",
      "lane": "customer",
      "col": 0,
      "type": "external",
      "label": "Customer message",
      "sublabel": "free text from a customer",
      "width": 164
    },
    {
      "id": "intake",
      "lane": "decide",
      "col": 1,
      "type": "backend",
      "label": "Intake",
      "sublabel": "Jev decision: topic + urgency",
      "width": 164
    },
    {
      "id": "answer",
      "lane": "write",
      "col": 3,
      "type": "backend",
      "label": "Answer",
      "sublabel": "Language model: drafts reply",
      "width": 164
    },
    {
      "id": "ground",
      "lane": "decide",
      "col": 4,
      "type": "backend",
      "label": "Grounding Checker",
      "sublabel": "Jev decision: grounded?",
      "width": 164
    },
    {
      "id": "escal",
      "lane": "decide",
      "col": 2,
      "type": "security",
      "label": "Escalation Router",
      "sublabel": "Jev decision: which queue",
      "width": 164
    },
    {
      "id": "send",
      "lane": "customer",
      "col": 5,
      "type": "frontend",
      "label": "Reply sent",
      "sublabel": "grounded in a source",
      "width": 164
    }
  ],
  "edges": [
    {
      "id": "msg-intake",
      "from": "msg",
      "to": "intake",
      "variant": "emphasis"
    },
    {
      "id": "intake-answer",
      "from": "intake",
      "to": "answer",
      "label": "topic, urgency",
      "variant": "emphasis"
    },
    {
      "id": "answer-ground",
      "from": "answer",
      "to": "ground",
      "label": "draft",
      "variant": "emphasis"
    },
    {
      "id": "ground-send",
      "from": "ground",
      "to": "send",
      "label": "grounded",
      "variant": "emphasis"
    },
    {
      "id": "ground-escal",
      "from": "ground",
      "to": "escal",
      "label": "not grounded",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "intake-escal",
      "from": "intake",
      "to": "escal",
      "label": "if not clearly decided",
      "variant": "security",
      "role": "branch"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Why a decision model for three of them",
      "items": [
        "Intake picks 1 of 5 topics and scores urgency",
        "Grounding Checker answers one yes or no question",
        "Escalation Router picks 1 of 3 queues"
      ]
    },
    {
      "dot": "amber",
      "title": "Why the fourth stays a language model",
      "items": [
        "Answer writes prose for a customer to read",
        "It is also the only agent that can drift from its source",
        "That drift is what the Grounding Checker exists to catch"
      ]
    },
    {
      "dot": "rose",
      "title": "What the live calls showed",
      "items": [
        "Jev returns a confidence for choice and score, and none for boolean",
        "Below 60% confident, a decision goes to a person instead of onward",
        "The grounding bar is the same 60%, set from 6 labeled drafts, not from one"
      ]
    }
  ]
}
