{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Run this agent: one real call, and the fallback",
    "visual_preset": "blueprint",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [
      1700,
      760
    ],
    "output": "public/architecture/jev-call-sequence.html",
    "views": [
      {
        "id": "guardrail",
        "label": "Guardrail first",
        "focus": [
          "libjev",
          "calls"
        ],
        "note": "The limits are checked before the Gateway is called, so a refusal costs nothing."
      },
      {
        "id": "live-call",
        "label": "The live call",
        "focus": [
          "libjev",
          "gateway",
          "jev"
        ],
        "note": "The only hop that leaves this system, and the only one that is timed."
      },
      {
        "id": "fallback",
        "label": "Recorded fallback",
        "focus": [
          "libjev",
          "calls",
          "panel",
          "visitor"
        ],
        "note": "A stored result from a real call, labelled with its date. Never a fabricated live one."
      }
    ]
  },
