  "cards": [
    {
      "dot": "emerald",
      "title": "Measured, not claimed",
      "items": [
        "Latency is wall clock around evaluate, because the SDK returns none",
        "22 live calls, median 430 ms, about $0.000017 each",
        "The call log stores a timestamp, agent, outcome, latency and a salted IP hash"
      ]
    },
    {
      "dot": "rose",
      "title": "The guardrail comes first",
      "items": [
        "10 live calls per IP per hour, 300 per day in total",
        "Only successful calls count, so a failure spends nobody's quota",
        "Both limits proven by moving the counter, not by faking a trigger"
      ]
    },
    {
      "dot": "amber",
      "title": "No user content is stored",
      "items": [
        "Not the message typed in, not the answer returned",
        "anon may execute the definer function and may never select the table",
        "The IP hash is salted with a server only secret"
      ]
    }
  ]
