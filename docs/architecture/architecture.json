  "cards": [
    {
      "dot": "emerald",
      "title": "Real",
      "items": [
        "Google sign in and the guard on /app",
        "projects and profiles, row level security proven with two users",
        "Jev decisions: 22 live calls, median 430 ms, $0.000017 each",
        "jev_calls: anon may insert through a definer function, never select"
      ]
    },
    {
      "dot": "amber",
      "title": "Simulated",
      "items": [
        "Builds, previews, deploys and agent runs are read from lib/seed",
        "Costs and versions are derived from those fixtures, not measured",
        "No code is generated, executed or shipped anywhere"
      ]
    },
    {
      "dot": "rose",
      "title": "Why the key stays server side",
      "items": [
        "lib/jev is server-only, so no client import can reach the key",
        "/jev/run sits outside the guard so the signed out demo still works",
        "Rate limit 10 per IP per hour, cap 300 per day, both proven"
      ]
    }
  ]
