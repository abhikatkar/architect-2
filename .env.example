# Copy to .env.local and fill the values.
# Supabase dashboard: Project Settings, then API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vercel AI Gateway, for the Jev decision model. Server only: never prefix this
# with NEXT_PUBLIC_. Create at Vercel, AI Gateway, API Keys.
AI_GATEWAY_API_KEY=

# Any random string. Salts the IP hashes in jev_calls so they are not
# reversible from the table alone. Server only.
JEV_IP_SALT=
